	(text "BJT Totem Pole Gate Drivers"
		(exclude_from_sim no)
		(at 213.106 18.796 0)
		(effects
			(font
				(size 3.81 3.81)
				(thickness 0.508)
				(bold yes)
				(color 0 0 0 1)
			)
		)
		(uuid "11e89b9a-c089-4472-bae0-b4893d14d244")
	)
	(text "Community suggests above 15KHz to remove audiable noise \nand as low as possible to reduce switching losses.\nSizing for 50KHz and can reduce speed through FW as needed.\n\nCgd + Cgs = ~700pF, V = 3.3V, Rgate = 22.1 (using same resistor as driver input Resistor)\nAt these values t = 1.55x10^-8. 2t gives ~32MHz. "
		(exclude_from_sim no)
		(at -80.772 37.338 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 132 1)
			)
			(justify left)
		)
		(uuid "12321fa1-5e8b-4206-a793-8273356b1cc6")
	)
	(text "Flyback diodes to protect the NMOS during inductive kickback.\n28.9V Zener breakdown, 2A continuous output.\nNMOS rated for 30V"
		(exclude_from_sim no)
		(at 81.026 44.196 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "17755ca5-254d-4d83-900c-8047ac5985af")
	)
	(text "Gate capacitance is ~7nF, Gate resistance is ~1.7Ohms\nt = 1.7*7*10^-9\nt = ~1.19ns\n4RC takes about 48ns, simulation shows ~200ns\nThis results in ~5MHz capable switching.\nApplication aims for a ~50-100KHz PWM"
		(exclude_from_sim no)
		(at 136.398 32.766 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "1e9862d6-5707-42a1-9433-86d4de4a8b48")
	)
	(text "Pull down resistors for gate\nProbably not required with the BJTs,\nbut it doesnt hurt."
		(exclude_from_sim no)
		(at 18.796 70.358 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "3a3af383-0191-4529-be6d-c084ae4c2027")
	)
	(text "Need to evaluate inductive kickback better.\nCurrent diode selected has a zener voltage of 28.9, while the fets Vdsmax is 30.\nBetter component selection or motor driver circuit might be required."
		(exclude_from_sim no)
		(at -81.28 52.578 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 132 0 0 1)
			)
			(justify left)
		)
		(uuid "7adbe27e-f6d8-45c9-a560-19c0550d183d")
	)
	(text "HSD could be safer, but PMOS have higher Rds-on. \nLSD is more power efficient but requires your load to always be supplied by Vdd.\n\nCould do H-Bridge"
		(exclude_from_sim no)
		(at 145.542 -6.604 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "7dbb8de5-c50a-4077-a07e-a61b94329cab")
	)
	(text "MOSFET Low Side Drives\n"
		(exclude_from_sim no)
		(at 62.484 20.574 0)
		(effects
			(font
				(size 3.81 3.81)
				(thickness 0.508)
				(bold yes)
				(color 0 0 0 1)
			)
		)
		(uuid "8340ab27-6cd5-48b6-897d-24b33fcb1536")
	)
	(text "RDS(on) max @V GS = 4.5V, 29 mΩ\nRDS(on) max @V GS = 2.5V, 37 mΩ"
		(exclude_from_sim no)
		(at 101.092 62.992 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "99da52c9-79f1-43c3-ae7f-537cff73406f")
	)
	(text "Current limiting resistors for micro:\nPins are rated for 25mA. Ill choose to limit to 15mA\nR = 3.3/0.015 = ~220"
		(exclude_from_sim no)
		(at 133.35 74.676 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "bae1e621-1dfd-44b6-9346-75a173571936")
	)
	(text "Package protection for current limiting \nresistors to protect the BJTs. \nSince BJTs can supply 150mA max, use 22ohms\n"
		(exclude_from_sim no)
		(at 243.84 40.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "d9e5130f-6e79-475c-8f16-9729b5dc0c7c")
	)
