	(text_box "Current/Voltage monitoring ICs\nDigital with I2C:INA3221AIRGVR (3 CHANNEL) ~$6\nAnalog output: INA4180A2IPWR 4channel $1.5\nAnalog output: INA2180A1IDGKR 2channel $0.9\n\nFor analog option, might need to filter before micro..\nReview datasheet"
		(exclude_from_sim no)
		(at 91.44 -12.7 0)
		(size 68.58 17.78)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type color)
			(color 255 255 194 1)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8dbc80ea-2a6e-42a9-8ab4-9bdb9f6ff8b0")
	)
	(text "INA4180A2 has a gain of 50.\nexpecting a max current of 2A on motors and 8A through VBAT. \nCould size up to 8A for whole system.\nrail to rail is gnd+5mv to vcc-30mv\nat vcc=3.3, vswing = ~3.2. Iin =8A,Imotor =2, gain =50\nRsense = Vswing/GxImax = 3.2/50x8 = 8mOhm.\n\nRsense_in = 8mOhm will work for Vout = 0.005-3.2V\nRsense_motor = 30mOhm will work for Motor current sense 0.005-3V\n"
		(exclude_from_sim no)
		(at 118.872 62.738 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 132 1)
			)
			(justify left top)
		)
		(uuid "97e09e17-2a96-44cc-8680-8ba75ca07f24")
	)
	(text "Current and Power Monitoring"
		(exclude_from_sim no)
		(at 148.844 19.812 0)
		(effects
			(font
				(size 3.81 3.81)
				(thickness 0.762)
				(bold yes)
				(color 0 0 0 1)
			)
		)
		(uuid "9eaf87fe-d698-4991-b751-a045958fab1b")
	)
